<Window x:Class="MoraEj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoraEj"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="0,0,0,335">
            <Label Content="Monto" HorizontalAlignment="Left" Margin="400,10,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="tbMonto" HorizontalAlignment="Left" Margin="482,14,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <Label Content="Fecha Venc.:" HorizontalAlignment="Left" Margin="78,52,0,0" VerticalAlignment="Top"/>
            <Label Content="Fecha Pago:" HorizontalAlignment="Left" Margin="400,52,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.551,0.085"/>
            <DatePicker x:Name="dpVencimiento" HorizontalAlignment="Left" Margin="172,55,0,0" VerticalAlignment="Top"/>
            <DatePicker x:Name="dpPago" HorizontalAlignment="Left" Margin="482,55,0,0" VerticalAlignment="Top"/>
        </Grid>
        <Label Content="Cliente:" HorizontalAlignment="Left" Margin="82,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbCliente" HorizontalAlignment="Left" Margin="151,14,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Grid Margin="0,104,0,271">
            <Button x:Name="btnCalcular" Content="Calcular" HorizontalAlignment="Left" Margin="228,0,0,0" VerticalAlignment="Center" Click="btnCalcular_Click"/>
            <Button x:Name="btnNuevo" Content="Nuevo" HorizontalAlignment="Left" Margin="360,0,0,0" VerticalAlignment="Center" Click="btnNuevo_Click"/>
            <Button x:Name="btnFinalizar" Content="Finalizar" HorizontalAlignment="Left" Margin="518,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.454,0.313"/>
        </Grid>
        <Grid Margin="0,168,0,179">
            <StackPanel Margin="95,0,371,0" Orientation="Horizontal">
                <Label Content="DIAS DE MORA" Width="95" Height="36"/>
                <TextBox x:Name="TBDIASM" TextWrapping="Wrap" Width="107" Height="30"/>
            </StackPanel>
            <StackPanel Margin="434,0,32,0" Orientation="Horizontal">
                <Label Content="MORA EN S/:" Height="54"/>
                <TextBox x:Name="tbMoraSoles" TextWrapping="Wrap" Width="120" Height="36"/>
            </StackPanel>
            <StackPanel Margin="95,121,371,-121"/>
            <StackPanel Margin="434,121,32,-121"/>
        </Grid>
        <Grid Margin="10,260,-10,77">
            <StackPanel Margin="72,0,462,0" Orientation="Horizontal">
                <Label Content="MORA EN %" Width="96" Height="100"/>
                <TextBox x:Name="tbMoraPorc" TextWrapping="Wrap" Width="145" Height="51"/>
            </StackPanel>
            <StackPanel Margin="420,0,114,0" Orientation="Horizontal">
                <Label Content="MONTO A PAGAR:"/>
                <TextBox x:Name="tbMontoaPagar" TextWrapping="Wrap" Width="120" Height="58"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
