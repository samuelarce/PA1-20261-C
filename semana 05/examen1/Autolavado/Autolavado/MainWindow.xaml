<Window x:Class="Autolavado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autolavado"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="10,10,10,287">
            <Label Content="AUTO-LIMPIO EXPRES" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top"/>
            <StackPanel Margin="142,31,409,0">
                <Label Content="Seleccione el tipo de vehiculo:"/>
                <RadioButton x:Name="rbAuto" Content="Auto (s/ 20.00)"/>
                <RadioButton x:Name="rbCamioneta" Content="Camioneta (s/ 30.00)"/>
                <RadioButton x:Name="rbSuv" Content="SUV (s/35.00)"/>
            </StackPanel>
            <StackPanel Margin="412,31,110,0">
                <Label Content="Servicios Adicionales:"/>
                <CheckBox x:Name="cbEncerado" Content="Encerado Premium"/>
                <CheckBox x:Name="cbLavado" Content="Lavado de motor" />
                <CheckBox x:Name="cbLimpieza" Content="Limpieza de salon"/>
            </StackPanel>
            <Label Content="Placa de Vehiculo" HorizontalAlignment="Left" Margin="22,31,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="tbPlaca" HorizontalAlignment="Left" Margin="22,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="120"/>
            <Button x:Name="btnEstadistica" Content="estadistica" HorizontalAlignment="Left" Margin="712,69,0,0" VerticalAlignment="Top" Click="btnEstadistica_Click"/>
        </Grid>
        <Grid Margin="0,152,0,81">
            <ListView x:Name="lvVehiculos" >
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding}" Header="Placa" Width="200"/>
                        <GridViewColumn DisplayMemberBinding="{Binding}" Header="Tipo de Vehiculo" Width="200"/>
                        <GridViewColumn DisplayMemberBinding="{Binding}" Header="Cantidad de S.Adicionales" Width="200"/>
                        <GridViewColumn DisplayMemberBinding="{Binding}" Header="Total a pagar" Width="200"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        <Button x:Name="btnRegistrar" Content="Registrar" HorizontalAlignment="Left" Margin="697,26,0,0" VerticalAlignment="Top" Click="btnRegistrar_Click"/>
    </Grid>
</Window>
