<Window x:Class="Productos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Productos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgProductos" AutoGenerateColumns="False" Grid.Row="0" >
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding ProductID}" Header="ID" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Binding="{Binding ProductName}" Header="Nombre Producto" Width="*"/>
                <DataGridTextColumn Binding="{Binding UnitPrice}" Header="Precio Unitario" Width="100"/>
                <DataGridTextColumn Binding="{Binding UnitsInStock}" Header="Stock" Width="100"/>
                <DataGridCheckBoxColumn Binding="{Binding Discontinued}" Width="100" Header="Discontinuado"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1">
            <Button x:Name="btnGuardar" Content="Sincronizar Cambios" HorizontalAlignment="Right" Background="#FF319E1B" Foreground="White" FontSize="16" Padding="5,5,5,5" Margin="0,5,0,5" Click="btnGuardar_Click" />
        </StackPanel>

    </Grid>
</Window>
