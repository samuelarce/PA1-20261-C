<Window x:Class="AgregarProducto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AgregarProducto"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Nombre: " Width="120"/>
                <TextBox x:Name="txtNombre" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Precio: " Width="120"/>
                <TextBox x:Name="txtPrecio" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnNuevo" Content="Nuevo" Margin="0,0,10,0" Width="100" Click="btnNuevo_Click" />
                <Button x:Name="btnAgregar" Content="Agregar Producto" Padding="0,5,0,5" Width="100" Click="btnAgregar_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Padding="10" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,10,0">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Nombre:" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtCatNombre" Width="180"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Descripción:" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtDescripcion" Width="180"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCatNuevo" Content="Nuevo" Margin="0,0,10,0" Width="100"/>
                    <Button x:Name="btnAgregarCategoria" Content="Agregar Categoría" Width="120" Click="btnAgregarCategoria_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgCategorias" IsReadOnly="True" Margin="0,10,0,25" Grid.Row="1"/>
    </Grid>
</Window>
