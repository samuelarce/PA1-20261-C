<Window x:Class="ModuloDespacho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModuloDespacho"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#5D5FA3" Height="48">
            <Grid>
                <TextBlock Text="MODULO DESPACHO" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Foreground="White" VerticalAlignment="Center" Text="Hora: " FontWeight="Bold" />
                    <TextBlock x:Name="SystemTimeText" Foreground="White" VerticalAlignment="Center" Margin="4,0" />
                    <TextBlock Foreground="White" VerticalAlignment="Center" Text=" | Sesión: " FontWeight="Bold" Margin="8,0,0,0" />
                    <TextBlock x:Name="SessionDurationText" Foreground="White" VerticalAlignment="Center" Margin="4,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left navigation: operador y clientes -->
        <StackPanel DockPanel.Dock="Left" Width="240" Background="#F2F2F2">
            <StackPanel Margin="8">
               
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Ellipse Width="48" Height="48">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="file:///C:/Users/samaq/Downloads/images.png" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Operador de despacho" FontWeight="Bold" />
                        <TextBox x:Name="OperatorTextBox" Width="140" Margin="0,4,0,0" Text="{Binding OperatorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <Separator />

                <TextBlock Text="Clientes" FontWeight="Bold" Margin="0,6" />
                <ListBox x:Name="ClientsListBox" SelectionChanged="ClientsListBox_SelectionChanged" MouseDoubleClick="ClientsListBox_MouseDoubleClick" DisplayMemberPath="CompanyName" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" SelectedValuePath="CustomerId"  Height="228" />
            </StackPanel>
        </StackPanel>

        
        <Border DockPanel.Dock="Right" Width="260" Background="#F7F7F7" Padding="8" Height="332">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Tipo de transportista" FontWeight="Bold" />
                    <ComboBox x:Name="TransportTypeCombo" Margin="0,6,0,6" SelectedItem="{Binding SelectedTransport, Mode=TwoWay}" SelectionChanged="TransportTypeCombo_SelectionChanged" DisplayMemberPath="Name" />
                    <TextBlock x:Name="SelectedTransportType" Margin="0,0,0,8" FontStyle="Italic" Foreground="#333" />

                    <TextBlock Text="Fecha límite de entrega" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                        <DatePicker x:Name="DeadlineDatePicker" SelectedDate="{Binding Deadline, Mode=TwoWay}" SelectedDateChanged="DeadlineDatePicker_SelectedDateChanged" />
                    </StackPanel>
                    <TextBlock x:Name="DeadlineSelectedText" Margin="0,6,0,0" FontStyle="Italic" Foreground="#333" />
                </StackPanel>

                    <Button x:Name="AuthorizeButton" DockPanel.Dock="Bottom" Content="Autorizar despacho" Margin="0,8,0,0"
                            Command="{Binding AuthorizeCommand}"  />
            </DockPanel>
        </Border>

        <!-- Main content area -->
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <!-- Encabezado de contenido -->
            <StackPanel Orientation="Horizontal" Margin="12" Grid.Row="0">
                <TextBlock Text="Detalle de envío" FontSize="18" FontWeight="Bold" />
            </StackPanel>

            <!-- Área principal de detalle -->
            <Border Grid.Row="1" Margin="12,12,12,10" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cliente: mostrar nombre, ciudad y teléfono encima del catálogo -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="8">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Width="240">
                                <TextBlock Text="Cliente" FontWeight="Bold" FontSize="12" />
                                <TextBlock x:Name="ClientNameText" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="160" Margin="12,0,0,0">
                                <TextBlock Text="Ciudad" FontWeight="Bold" FontSize="12" />
                                <TextBlock x:Name="ClientCityText" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Width="120" Margin="12,0,0,0">
                                <TextBlock Text="Teléfono" FontWeight="Bold" FontSize="12" />
                                <TextBlock x:Name="ClientPhoneText" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="8">
                        <TextBlock Text="Catálogo de productos" FontWeight="Bold" />

                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="CatalogFilterTextBox" Width="200" Margin="0,0,8,0" TextChanged="CatalogFilterTextBox_TextChanged" />
                        </StackPanel>
                        <ListBox x:Name="CatalogListBox" Height="120" Margin="0,6,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="{Binding ProductName}" Width="200" />
                                        <TextBlock Text="Precio: " Foreground="#333" />
                                        <TextBlock Text="{Binding UnitPrice, StringFormat=S/0.00}" Width="80" />
                                        <TextBlock Text="Stock: " Foreground="#333" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding UnitsInStock}" Width="60" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                       
                        <TextBlock Text="(Doble clic para agregar al pedido a la lista)" FontSize="11" Foreground="#666" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Lista de items seleccionados -->
                    <DataGrid x:Name="ItemsDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" Margin="8,8,8,25" CanUserAddRows="False" CellEditEnding="ItemsDataGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                            <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Precio unitario" Binding="{Binding PrecioUnitario, StringFormat=C}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Dto" Binding="{Binding Dto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="120" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Pie con totales -->
            <Border Grid.Row="2" Background="#EEF3FB" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SubtotalTb" Text="Subtotal: " Margin="0,0,20,0" />
                        <TextBlock x:Name="FleteTb" Text="Flete: " Margin="0,0,20,0" />
                        <TextBlock Text="TOTAL GENERAL: " FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalTb" Text="" FontWeight="Bold" FontSize="14" Margin="6,0,20,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
