<Window x:Class="ExPracticoII.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExPracticoII"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid HorizontalAlignment="Right" Width="800">
        <Grid.RowDefinitions>
            <RowDefinition Height="73*"/>
            <RowDefinition Height="192*"/>
            <RowDefinition Height="169*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,384,0">
            <TextBlock TextWrapping="Wrap" Text="Elija Pais de Destino" Width="152" Height="46"/>
            <ComboBox x:Name="cboPais" Width="162" Height="31"/>
        </StackPanel>
        <DataGrid Margin="0,73,0,0" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N° Orden" Binding="{Binding OrderID}" FontSize="14" Width="*"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding CompanyName}" FontSize="14" Width="*"/>
                <DataGridTextColumn Header="Fecha Pedido" Binding="{Binding OrderDate}" FontSize="14" Width="*"/>
                <DataGridTextColumn Header="Flete" Binding="{Binding Freight}" FontSize="14" Width="*"/>
                <DataGridTextColumn Header="País Destino" Binding="{Binding ShipCountry}" FontSize="14" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="btnIniciar" Content="Iniciar Supervisión" HorizontalAlignment="Left" Margin="484,22,0,0" VerticalAlignment="Top" Height="30" Width="100"/>
        <Button x:Name="btnDetener" Content="Detener Supervisión" HorizontalAlignment="Left" Margin="659,22,0,0" VerticalAlignment="Top" Height="30" Width="111"/>
        <TextBlock HorizontalAlignment="Left" Margin="127,10,0,0" Grid.Row="2" TextWrapping="Wrap" Text="ESTADO: " VerticalAlignment="Top"/>
        <Label x:Name="lbEstado" Content="........." HorizontalAlignment="Left" Margin="186,5,0,0" Grid.Row="2" VerticalAlignment="Top" Width="63"/>
        <TextBlock HorizontalAlignment="Left" Margin="127,54,0,0" Grid.Row="2" TextWrapping="Wrap" Text="TOTAL DE ORDENES PENDIENTES:" VerticalAlignment="Top"/>
        <Label x:Name="lbOrdenesPendientes" Content="?" HorizontalAlignment="Left" Margin="313,49,0,0" Grid.Row="2" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="127,106,0,0" Grid.Row="2" TextWrapping="Wrap" Text="ULTIMO REFRESCO DE DATOS: " VerticalAlignment="Top"/>
        <Label x:Name="lbHoraRefresco" Content="--:--:--" HorizontalAlignment="Left" Margin="321,101,0,0" Grid.Row="2" VerticalAlignment="Top" RenderTransformOrigin="1,-0.192"/>
    </Grid>
</Window>
