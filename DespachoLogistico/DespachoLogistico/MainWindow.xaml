<Window x:Class="DespachoLogistico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DespachoLogistico"
        mc:Ignorable="d"
        Title="Sistema de Despacho Logístico Express" Height="600" Width="1000" MinHeight="480" MinWidth="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Sistema de Despacho Logístico Express" FontSize="18" VerticalAlignment="Center" FontWeight="SemiBold" />

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="Empleado de turno" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="TxtEmpleadoNombre" Text="Nombre Apellido" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Contenido principal: columnas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: Categorías y Productos -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#FFF" Padding="8" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1">
                    <TextBlock Text="Categorías" FontWeight="Bold"/>
                </Border>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <!-- ListBox de categorías -->
                        <ListBox x:Name="LstCategorias" MinHeight="120" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" SelectionMode="Single">
                            <!-- LLenado desde VM -->
                        </ListBox>

                        <Border Background="#FFF" Padding="8" CornerRadius="4" BorderBrush="#DDD" BorderThickness="1">
                            <TextBlock Text="Productos" FontWeight="Bold"/>
                        </Border>

                        <!-- Buscador de productos por nombre -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="TxtBuscarProducto" Width="180" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Buscar producto por nombre"/>
                            <Button x:Name="BtnBuscarProducto" Content="Buscar" Width="70"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="240" Margin="0,8,0,0">
                            <ListBox x:Name="LstProductos">
                                <!-- Productos con stock; enlazar desde VM -->
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Columna central: Detalle del pedido -->
            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Detalle del pedido" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAgregar" Content="+ Agregar" Margin="8,0,0,0" Click="BtnAgregar_Click"/>
                    <Button x:Name="BtnQuitar" Content="- Quitar" Margin="8,0,0,0"/>
                </StackPanel>

                <DataGrid x:Name="GridDetalle" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
                        <DataGridTextColumn Header="P. Unit. (S/)" Binding="{Binding Precio, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/>
                        <DataGridTextColumn Header="Total (S/)" Binding="{Binding Total, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Columna derecha: Cliente, Empleado, Fecha y Resumen -->
            <StackPanel Grid.Column="2" Orientation="Vertical">
                <TextBlock Text="Cliente" FontWeight="Bold"/>
                <ComboBox x:Name="CbxCliente" MinWidth="200" Margin="0,4,0,8" />

                <TextBlock Text="Empleado de turno" FontWeight="Bold"/>
                <ComboBox x:Name="CbxEmpleado" MinWidth="200" Margin="0,4,0,8" />

                <TextBlock Text="Fecha límite envío" FontWeight="Bold"/>
                <DatePicker x:Name="DpFechaLimite" Margin="0,4,0,12" />

                <Border Background="#F8F8F8" Padding="12" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Resumen" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSubtotal" Text="0.00 S/" Margin="12,0,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="IGV (18%):"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtIGV" Text="0.00 S/" Margin="12,0,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Total:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtTotal" Text="0.00 S/" Margin="12,0,0,0" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Espacio para calendario u otros widgets si se desea -->
                <StackPanel Margin="0,12,0,0">
                    <!-- Placeholder -->
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Pie: acciones finales -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtItemsPedido" Text="Items en pedido: 0" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLimpiar" Content="Limpiar" Width="100" Margin="0,0,8,0"/>
                <Button x:Name="BtnProcesar" Content="Procesar Despacho" Width="140" Background="#2D9CDB" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
