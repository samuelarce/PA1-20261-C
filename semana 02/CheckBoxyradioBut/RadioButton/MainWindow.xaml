<Window x:Class="RadioButton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadioButton"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Numero A" HorizontalAlignment="Left" Margin="221,31,0,0" VerticalAlignment="Top" RenderTransformOrigin="-2.411,-1.193"/>
        <Label Content="Numero B" HorizontalAlignment="Left" Margin="222,76,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtNumeroA" HorizontalAlignment="Left" Margin="319,31,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="98" Height="31"/>
        <RadioButton x:Name="rbSuma" Content="Suma +" HorizontalAlignment="Left" Margin="235,180,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbMultiplicacion" Content="Multiplicacion *" HorizontalAlignment="Left" Margin="235,217,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbDivision" Content="Division /" HorizontalAlignment="Left" Margin="375,217,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbResta" Content="Resta -" HorizontalAlignment="Left" Margin="375,180,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnCalcular" Content="Calcular" HorizontalAlignment="Left" Margin="319,252,0,0" VerticalAlignment="Top" Click="btnCalcular_Click"/>
        <Label x:Name="lbResultado" Content="" HorizontalAlignment="Left" Margin="319,277,0,0" VerticalAlignment="Top" Width="236"/>
        <TextBox x:Name="txtNumeroB" HorizontalAlignment="Left" Margin="319,89,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="98" Height="31"/>

    </Grid>
</Window>
