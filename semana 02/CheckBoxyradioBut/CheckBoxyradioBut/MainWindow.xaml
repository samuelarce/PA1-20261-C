<Window x:Class="CheckBoxyradioBut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CheckBoxyradioBut"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <CheckBox x:Name="cbCebolla" Content="Cebolla s/3" HorizontalAlignment="Left" Margin="112,58,0,0" VerticalAlignment="Top" Checked="CheckBox_Checked" IsChecked="False"/>
        <CheckBox x:Name="cbTomate" Content="Tomate s/ 1.5" HorizontalAlignment="Left" Margin="112,100,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbPapa" Content="Papa s/2.00" HorizontalAlignment="Left" Margin="116,141,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnCalcular" Content="Calcular Total" HorizontalAlignment="Left" Margin="112,231,0,0" VerticalAlignment="Top" Click="btnCalcular_Click"/>
        <Label x:Name="lbTotal" Content="Total s/" HorizontalAlignment="Left" Margin="152,278,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtCantidad" HorizontalAlignment="Left" Margin="127,200,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="60"/>
        <Label Content="Cantidad" HorizontalAlignment="Left" Margin="100,169,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
