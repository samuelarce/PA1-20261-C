        xmlns:local="clr-namespace:EjercicioRButton"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label x:Name="lbmedida" Content="Unidad a medir" HorizontalAlignment="Left" Margin="103,43,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtMedida" HorizontalAlignment="Left" Margin="147,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <RadioButton x:Name="rbCP" Content="Cm a pulgadas" HorizontalAlignment="Left" Margin="122,136,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbPC" Content="Pulgadas a Centimetros" HorizontalAlignment="Left" Margin="122,180,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnCalcular" Content="Calcular" HorizontalAlignment="Left" Margin="155,234,0,0" VerticalAlignment="Top" Click="btnCalcular_Click"/>
        <Label x:Name="lbResultado" Content="" HorizontalAlignment="Left" Margin="207,267,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.484,-1.212"/>

    </Grid>
</Window>
