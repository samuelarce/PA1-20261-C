<Window x:Class="GestiondeOrdenesdeVenta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestiondeOrdenesdeVenta"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinWidth="600" MinHeight="350">
    <Border Margin="10" BorderBrush="Black" BorderThickness="2" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Formulario: usa una cuadrícula con 3 columnas; los controles se estiran automáticamente -->
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                    <TextBlock Text="Order ID" />
                    <TextBox x:Name="txtOrderId" HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <TextBlock Text="Cliente" />
                    <ComboBox x:Name="cboCliente" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Ana Trujillo Emparedados y Helados"/>
                        <ComboBoxItem Content="Rattlesnake Canyon Grocery"/>
                        <ComboBoxItem Content="Bon app"/>
                        <ComboBoxItem Content="Richter Supermarkt"/>
                        <ComboBoxItem Content="Simons Bistro"/>
                        <ComboBoxItem Content="Pericles Comidas Clasicas"/>
                        <ComboBoxItem Content="Ernst Handel"/>
                        <ComboBoxItem Content="LILA-Supermercados"/>
                        <ComboBoxItem Content="Tortuga restaurante"/>
                        <ComboBoxItem Content="Queen Cozinha"/>
                        <ComboBoxItem Content="Drachenblut Delikatessen"/>
                        <ComboBoxItem Content="White Clover Markets"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                    <TextBlock Text="Empleado" />
                    <ComboBox x:Name="cboEmpleado" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Janet Leverling"/>
                        <ComboBoxItem Content="Nancy Davolio"/>
                        <ComboBoxItem Content="Margaret Peacock"/>
                        <ComboBoxItem Content="Laura Callahart"/>
                        <ComboBoxItem Content="Robert King"/>
                        <ComboBoxItem Content="Andrew Fuller"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                    <TextBlock Text="Transportista (ShipVia)" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <RadioButton x:Name="rbSpeedy" Content="Speedy Express" GroupName="TransportistaGroup" Margin="0,0,10,0"/>
                        <RadioButton x:Name="rbUnited" Content="United Package" GroupName="TransportistaGroup" Margin="0,0,10,0"/>
                        <RadioButton x:Name="rbFederal" Content="Federal Shipping" GroupName="TransportistaGroup"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                    <TextBlock Text="Fecha de Pedido" />
                    <DatePicker x:Name="dpFecha" HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                    <TextBlock Text="Monto de Envío (Freight)" />
                    <TextBox x:Name="txtMontodeEnvio" HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="4">
                    <TextBlock Text="Nombre de Destino (shipName)" />
                    <TextBox x:Name="txtNombreDestino" HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="4">
                    <TextBlock Text="Ciudad de Destino (shipCity)" />
                    <TextBox x:Name="txtCiudadDestino" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>

            <!-- Botones -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="12">
                <Button x:Name="btnGuardar" Content="Guardar" Margin="4" Padding="8,4"/>
                <Button x:Name="btnActualizar" Content="Actualizar" Margin="4" Padding="8,4"/>
                <Button x:Name="btnEliminar" Content="Eliminar" Margin="4" Padding="8,4"/>
                <Button x:Name="btnLimpiar" Content="Limpiar" Margin="4" Padding="8,4"/>
            </StackPanel>

            <!-- Lista: ocupa todo el espacio restante -->
            <ListView x:Name="lvOrden" Grid.Row="2" Margin="8">
                <ListView.View>
                    <GridView>
                        <!-- Los anchos de columna se calculan en el code-behind para ocupar todo el ancho disponible -->
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ID}" />
                        <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding Cliente}" />
                        <GridViewColumn Header="Empleado" DisplayMemberBinding="{Binding Empleado}" />
                        <GridViewColumn Header="Transportista" DisplayMemberBinding="{Binding Transportista}" />
                        <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding Fecha}" />
                        <GridViewColumn Header="Freight" DisplayMemberBinding="{Binding Freight}" />
                        <GridViewColumn Header="Destino" DisplayMemberBinding="{Binding Destino}" />
                        <GridViewColumn Header="Ciudad" DisplayMemberBinding="{Binding Ciudad}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Border>
</Window>
