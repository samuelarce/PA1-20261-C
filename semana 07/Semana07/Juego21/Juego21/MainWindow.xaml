<Window x:Class="Juego21.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Juego21"
        mc:Ignorable="d"
        Title="Juego 21" Height="520" Width="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="BtnNuevo" Content="Nuevo Juego" Width="120" Height="30" Click="BtnNuevo_Click" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Jugador 1 -->
            <Border Grid.Column="0" Background="#FF2E8B57" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LblJugador1" Text="Jugador 1 - Puntos: 0" Foreground="White" FontWeight="Bold" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelCartas1" Height="300" VerticalAlignment="Top" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Button x:Name="BtnPedir1" Content="Pedir Carta" Width="100" Margin="0,0,10,0" Click="BtnPedir1_Click" />
                        <Button x:Name="BtnPlantarse1" Content="Plantarse" Width="100" Click="BtnPlantarse1_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Separador -->
            <Border Grid.Column="1" />

            <!-- Jugador 2 -->
            <Border Grid.Column="2" Background="#FF2E8B57" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LblJugador2" Text="Jugador 2 - Puntos: 0" Foreground="White" FontWeight="Bold" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PanelCartas2" Height="300" VerticalAlignment="Top" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Button x:Name="BtnPedir2" Content="Pedir Carta" Width="100" Margin="0,0,10,0" Click="BtnPedir2_Click" />
                        <Button x:Name="BtnPlantarse2" Content="Plantarse" Width="100" Click="BtnPlantarse2_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFF4A460" CornerRadius="4" Padding="8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtResultado" Text="Bienvenido al Juego 21" HorizontalAlignment="Center" FontWeight="Bold" />
        </Border>
    </Grid>
</Window>
