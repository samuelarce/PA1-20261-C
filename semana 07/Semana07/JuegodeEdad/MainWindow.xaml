<Window x:Class="JuegodeEdad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JuegodeEdad"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="68*"/>
            <RowDefinition Height="72*"/>
            <RowDefinition Height="79*"/>
            <RowDefinition Height="67*"/>
            <RowDefinition Height="73*"/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Center" Margin="0,27,0,0" TextWrapping="Wrap" Text="Indique un intervalo de edades" VerticalAlignment="Top" FontSize="18" FontWeight="Bold" Height="24" Width="275"/>
        <TextBox x:Name="tbEdadInferior" HorizontalAlignment="Left" Margin="220,0,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" Height="48"/>
        <TextBox x:Name="tbEdadSuperior" HorizontalAlignment="Left" Margin="489,0,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" Height="48"/>
        <TextBlock HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" Text="La computadora piensa que tu edad es: " VerticalAlignment="Center" FontWeight="Bold" FontSize="18" TextAlignment="Center"/>
        <TextBox x:Name="tbEdadGenerada" HorizontalAlignment="Center" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Width="120" Height="47"/>
        <Button x:Name="btnCorrecto" Content="Correcto" HorizontalAlignment="Left" Margin="220,8,0,0" Grid.Row="5" VerticalAlignment="Top" Height="47" Width="120" Click="btnCorrecto_Click"/>
        <Button x:Name="btnIncorrecto" Content="Incorrecto" HorizontalAlignment="Left" Margin="489,8,0,0" Grid.Row="5" VerticalAlignment="Top" Height="47" Width="120" Click="btnIncorrecto_Click"/>
        <Button x:Name="btnGenerarEdad" Content="Primer Intento" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="2" VerticalAlignment="Top" Height="46" Width="120" Click="btnGenerarEdad_Click"/>

    </Grid>
</Window>
