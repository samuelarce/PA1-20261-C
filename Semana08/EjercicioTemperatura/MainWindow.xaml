<Window x:Class="EjercicioTemperatura.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjercicioTemperatura"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Margin="20,30" RenderTransformOrigin="0.382,0.53">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="306*"/>
            <ColumnDefinition Width="239*"/>
            <ColumnDefinition Width="215*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="lbMeses" Grid.Column="2"/>
        <StackPanel Grid.Column="1">
            <Button x:Name="btn_MostrarCalculos" Content="Mostrar Calculos" Click="btn_MostrarCalculos_Click"/>
            <TextBlock TextWrapping="Wrap" Text="Promedio" Height="30" HorizontalAlignment="Center" FontWeight="Bold"/>
            <TextBlock x:Name="tbPromedio" TextWrapping="Wrap" Height="48" Background="#FFA1DDD0" TextAlignment="Center"/>
            <TextBlock TextWrapping="Wrap" Text="Nro Temp. Mayores al promedio" Height="70" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock x:Name="tbTMP" TextWrapping="Wrap" Height="52" Background="#FFB7E6DE" TextAlignment="Center"/>
            <Button x:Name="btn_GuardarRegistro" Content="Guardar Registro" />
        </StackPanel>
        <Border BorderBrush="Black" BorderThickness="1" Background="#FFE8E05C">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Text="Temperaturas Promedio Mensuales"/>
                <UniformGrid Rows="6" Columns="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Enero" Width="60"/>
                        <TextBox x:Name="txtEnero" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Julio" Width="60"/>
                        <TextBox x:Name="txtJulio" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Febrero" Width="60"/>
                        <TextBox x:Name="txtFebrero" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Agosto" Width="60"/>
                        <TextBox x:Name="txtAgosto" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Marzo" Width="60"/>
                        <TextBox x:Name="txtMarzo" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Septiembre" Width="60"/>
                        <TextBox x:Name="txtSeptiembre" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Abril" Width="60"/>
                        <TextBox x:Name="txtAbril" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Octubre" Width="60"/>
                        <TextBox x:Name="txtOctubre" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mayo" Width="60"/>
                        <TextBox x:Name="txtMayo" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Noviembre" Width="60"/>
                        <TextBox x:Name="txtNoviembre" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Junio" Width="60"/>
                        <TextBox x:Name="txtJunio" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Diciembre" Width="60"/>
                        <TextBox x:Name="txtDiciembre" Width="80"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
