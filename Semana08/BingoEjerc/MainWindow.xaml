                </Border>
                <Border  BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt32" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt33" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                <Border  BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt34" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>


                <Border  BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt40" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                <Border  BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt41" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                <Border  BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt42" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt43" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt44" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
