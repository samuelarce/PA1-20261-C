                </Border>


                <Border  BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt20" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                <Border  BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt21" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" Background="Gold" Margin="2">
                    <TextBlock x:Name="txt22" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Text="FREE"/>
                </Border>
                <Border  BorderBrush="#BDC3C7" BorderThickness="1" Background="White" Margin="2">
                    <TextBlock x:Name="txt23" Width="50" Height="25" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                </Border>
