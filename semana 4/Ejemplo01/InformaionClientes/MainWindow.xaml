<Window x:Class="InformaionClientes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformaionClientes"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="44,54,311,331"/>

        <Grid Margin="27,0,68,385"/>

        <Label Content="Cliente: " HorizontalAlignment="Left" Margin="61,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbCliente" HorizontalAlignment="Left" Margin="119,14,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" RenderTransformOrigin="-0.355,-1.479"/>
        <Label Content="Nro.Cel: " HorizontalAlignment="Left" Margin="400,10,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbCelular" HorizontalAlignment="Left" Margin="474,14,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" RenderTransformOrigin="-0.355,-1.479"/>
        <Label Content="Cantidad: " HorizontalAlignment="Left" Margin="61,66,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbPaginas" HorizontalAlignment="Left" Margin="129,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Páginas" HorizontalAlignment="Left" Margin="268,66,0,0" VerticalAlignment="Top"/>
        <Label Content="Tarifa: " HorizontalAlignment="Left" Margin="61,106,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbEscolar" Content="Escolar" HorizontalAlignment="Left" Margin="147,112,0,0" VerticalAlignment="Top" />
        <RadioButton x:Name="rbUniversitario" Content="Universitario" HorizontalAlignment="Left" Margin="233,112,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbOrganizacion" Content="Organizacion" HorizontalAlignment="Center" Margin="0,112,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnEstadistica" Content="Estadistica" HorizontalAlignment="Left" Margin="543,109,0,0" VerticalAlignment="Top" Click="btnEstadistica_Click"/>
        <Grid Margin="10,166,10,118">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="37*"/>
                <ColumnDefinition Width="158*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="lbCliente"  Margin="10,21,625,0" Grid.ColumnSpan="2" />
            <ListBox x:Name="lbCelular"  Margin="30,21,474,0" Grid.Column="1"/>
            <ListBox x:Name="lbPaginas"  Margin="183,21,318,0" Grid.Column="1"/>
            <ListBox x:Name="lbTarifa"  Margin="333,21,168,0" Grid.Column="1"/>
            <ListBox x:Name="lbImporte" Grid.Column="1"  Margin="483,21,0,0"/>
            <Label Content="Cliente:" HorizontalAlignment="Left" Margin="10,-5,0,0" VerticalAlignment="Top"/>
            <Label Grid.Column="1" Content="Nro. Cel: " HorizontalAlignment="Left" Margin="30,-3,0,0" VerticalAlignment="Top"/>
            <Label Grid.Column="1" Content="Cantidad:" HorizontalAlignment="Left" Margin="183,-3,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.011,0.687"/>
            <Label Grid.Column="1" Content="Importe" HorizontalAlignment="Left" Margin="483,-2,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.232,0.364"/>
            <Label Grid.Column="1" Content="Tarifa: " HorizontalAlignment="Left" Margin="333,-2,0,0" VerticalAlignment="Top"/>
        </Grid>
        <Grid Margin="64,321,10,23">
            <Label Content="Nro. Impre. Escolares:" HorizontalAlignment="Left" Margin="7,14,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="tbImpEscolares" HorizontalAlignment="Left" Margin="160,22,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <Label Content="Nro. Impre. Universitarios:" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
            <TextBox x:Name="tbImpreUniversitarios" HorizontalAlignment="Left" Margin="160,48,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="tbImpreOrganizacionales" HorizontalAlignment="Left" Margin="542,18,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <Label Content="Nro. Impre. Organizacionales:" HorizontalAlignment="Left" Margin="374,14,0,0" VerticalAlignment="Top"/>
        </Grid>
        <Button x:Name="btnRegistrar" Content="Registrar" HorizontalAlignment="Left" Margin="547,73,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.394,-0.359" Click="btnRegistrar_Click"/>
        <Button x:Name="btnSalir" Content="Salir" HorizontalAlignment="Left" Margin="692,94,0,0" VerticalAlignment="Top" Click="btnSalir_Click"/>
        

    </Grid>
</Window>
